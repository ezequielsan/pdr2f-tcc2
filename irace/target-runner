#!/usr/bin/env bash
###############################################################################
# target-runner: executa UMA configuracao candidata do irace em UMA instancia.
#
# O irace chama este script assim:
#
#   target-runner <id-config> <id-instancia> <semente> <instancia> \
#                 population_size 300 elite_percentage 0.15 ...
#
# e espera, na saida padrao, um unico numero: o CUSTO, que ele minimiza:
#
#   custo = peso + 0,999 * t_melhor / T
#
# em que t_melhor e' o instante em que a melhor solucao apareceu e T o limite
# de tempo. Os pesos sao inteiros e o termo de tempo e' menor que 1, entao uma
# solucao melhor sempre ganha; entre configuracoes que chegam ao mesmo peso,
# ganha a que chega mais rapido. Sem esse desempate, todas as configuracoes
# que param no otimo empatariam.
#
# O que este script faz:
#   1. monta um arquivo de configuracao a partir da base do braco ($IRACE_BASE),
#      SUBSTITUINDO os parametros calibrados (a API recusa chave duplicada);
#   2. busca o alvo da instancia em results/baseline/alvos.csv (otimo provado
#      pelo PLI ou limite inferior das cubicas; vazio = sem alvo);
#   3. roda o main_complete com uma thread, decodificador por permutacao e
#      busca local, ate' 120 s ou ate' atingir o alvo;
#   4. verifica a saida (29 campos, solucao viavel, braco certo) e devolve o
#      custo.
#
# Qualquer falha encerra com codigo 1, o que faz o irace PARAR com mensagem,
# em vez de calibrar em cima de execucoes quebradas.
#
# Variaveis de ambiente (o roda_irace.sh define as tres primeiras):
#   IRACE_BASE=<arq>      configuracao-base do braco (base-mp.conf ou base-ipr.conf)
#   IRACE_BRACO=mp|ipr    braco esperado; confere o rotulo que o main_complete deduz
#   IRACE_REGISTRO=<arq>  CSV com uma linha por execucao
#   IRACE_MAXTIME=<s>     forca outro limite de tempo (teste de fumaca: 2 s)
###############################################################################

set -u

erro() { echo "target-runner: ERRO: $*" >&2; exit 1; }

DIR="$(cd "$(dirname "$0")" && pwd)"
RAIZ="$(cd "$DIR/.." && pwd)"
BINARIO="$RAIZ/main_complete"
BASE="${IRACE_BASE:-}"
ALVOS="$RAIZ/results/baseline/alvos.csv"

[ $# -ge 4 ] || erro "argumentos insuficientes: $*"
ID_CONFIG="$1"
ID_INSTANCIA="$2"
SEMENTE="$3"
INSTANCIA="$4"
shift 4

[ -x "$BINARIO" ] || erro "$BINARIO nao encontrado; rode 'make' na raiz"
[ -n "$BASE" ]    || erro "IRACE_BASE nao definida; rode pelo roda_irace.sh"
[ -f "$BASE" ]    || erro "$BASE nao encontrado"
[ -f "$ALVOS" ]   || erro "$ALVOS nao encontrado; rode scripts/gera_alvos.py"

###############################################################################
# Caminho da instancia
#
# O irace pode executar este script a partir de execDir e ainda prefixar o
# caminho com trainInstancesDir. Para nao depender disso, extraimos o trecho a
# partir de "/instances/" e resolvemos em relacao a' raiz do repositorio.
# A barra inicial no padrao impede casar com "geoinstances/".
###############################################################################

CAMINHO="/$INSTANCIA"
RELATIVO="${CAMINHO##*/instances/}"
[ "$RELATIVO" != "$CAMINHO" ] || erro "caminho de instancia inesperado: $INSTANCIA"
ARQ_INSTANCIA="$RAIZ/instances/$RELATIVO"
[ -f "$ARQ_INSTANCIA" ] || erro "instancia nao encontrada: $ARQ_INSTANCIA"

###############################################################################
# Configuracao candidata: os parametros chegam em pares "chave valor"
###############################################################################

declare -A PARAMS=()
while [ $# -gt 0 ]; do
    [ $# -ge 2 ] || erro "parametro sem valor: $1"
    PARAMS["$1"]="$2"
    shift 2
done

TMP="$(mktemp -d)"
trap 'rm -rf "$TMP"' EXIT
CONF="$TMP/config.conf"

# Repassa os pares ao awk como "chave=valor" e substitui as linhas cujas chaves
# coincidem; as demais linhas de base.conf passam intactas.
PARES=""
for chave in "${!PARAMS[@]}"; do PARES+="$chave=${PARAMS[$chave]};"; done

awk -v pares="$PARES" '
    BEGIN {
        n = split(pares, lista, ";")
        for(i = 1; i <= n; ++i)
            if(split(lista[i], kv, "=") == 2) novo[kv[1]] = kv[2]
    }
    {
        chave = tolower($1)
        if(chave in novo) { print chave " " novo[chave]; usado[chave] = 1 }
        else print
    }
    END {
        for(k in novo) if(!(k in usado)) {
            print "parametro sem linha correspondente em base.conf: " k > "/dev/stderr"
            exit 3
        }
    }
' "$BASE" > "$CONF" || erro "falha ao montar a configuracao"

###############################################################################
# Limite de tempo e alvo
#
# 120 s para todas as instancias: 20% dos 600 s da bateria final, escolhidos
# para as duas calibracoes caberem em ~2 dias (protocolo de 05/11/2026).
###############################################################################

TEMPO="${IRACE_MAXTIME:-120}"

NOME="$(basename "$RELATIVO" .txt)"
ALVO=$(awk -F, -v i="$NOME" 'NR > 1 && $1 == i { print $4 }' "$ALVOS")
[ -n "$ALVO" ] || ALVO=0

###############################################################################
# Execucao
###############################################################################

LINHA=$("$BINARIO" --config "$CONF" --instance "$ARQ_INSTANCIA" \
                   --decoder permutation --seed "$SEMENTE" \
                   --maxtime "$TEMPO" --target "$ALVO" \
                   --threads 1 --quiet 2> "$TMP/stderr" | tail -1)

CAMPOS=$(echo "$LINHA" | awk -F, '{print NF}')
[ "$CAMPOS" = "29" ] || erro "saida inesperada do main_complete ($CAMPOS campos): $(head -3 "$TMP/stderr")"

ALGORITMO=$(echo "$LINHA" | cut -d, -f5)
PESO=$(echo "$LINHA" | cut -d, -f9)
VIAVEL=$(echo "$LINHA" | cut -d, -f10)
T_MELHOR=$(echo "$LINHA" | cut -d, -f17)
[ "$VIAVEL" = "yes" ] || erro "solucao INVIAVEL em $RELATIVO (config $ID_CONFIG)"
[ -s "$TMP/stderr" ] && grep -q "ERRO" "$TMP/stderr" && \
    erro "main_complete reportou erro em $RELATIVO: $(head -3 "$TMP/stderr")"

case "${IRACE_BRACO:-}" in
    mp)  [ "$ALGORITMO" = "brkga-mp" ]     || erro "esperado brkga-mp, executou $ALGORITMO" ;;
    ipr) [ "$ALGORITMO" = "brkga-mp-ipr" ] || erro "esperado brkga-mp-ipr, executou $ALGORITMO" ;;
    *)   erro "IRACE_BRACO deve ser mp ou ipr" ;;
esac

# Custo: peso, com o tempo ate' a melhor solucao como desempate (ver o topo).
CUSTO=$(awk -v p="$PESO" -v t="$T_MELHOR" -v T="$TEMPO" \
            'BEGIN { if(t > T) t = T; printf "%.6f", p + 0.999 * t / T }')

# Registro de todas as execucoes, para diagnostico posterior.
REGISTRO="${IRACE_REGISTRO:-$DIR/exec/execucoes.csv}"
mkdir -p "$(dirname "$REGISTRO")"
(
    flock 9
    [ -s "$REGISTRO" ] || echo "ConfigId,InstanceId,TimeLimitIrace,Cost,$("$BINARIO" --header)" > "$REGISTRO"
    echo "$ID_CONFIG,$ID_INSTANCIA,$TEMPO,$CUSTO,$LINHA" >> "$REGISTRO"
) 9> "$REGISTRO.lock"

# O irace le' apenas isto.
echo "$CUSTO"
